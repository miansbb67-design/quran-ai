# Bayan AI Quran Teacher

## Environment Configuration
APP_NAME="Bayan AI Quran Teacher"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/quran-ai/public

# Database Configuration (XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quran_ai
DB_USER=root
DB_PASS=

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Audio Recitation Defaults
DEFAULT_QARI_ID=1
DEFAULT_AUDIO_SOURCE=everyayah

# Security & Session
SESSION_LIFETIME=86400
CSRF_SECRET=bayan_quran_secure_token_change_in_prod_xyz_2026

# Admin Default Account
ADMIN_EMAIL=admin@bayan.test
ADMIN_PASSWORD=Admin@123456
